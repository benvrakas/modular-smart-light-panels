	(footprint "ModularLight:CornerJoint_R"
		(layer "F.Cu")
		(uuid "bf2418d8-3804-455f-8124-28340653cedc")
		(at 141.165 100)
		(descr "Polygon corner joint at the right end of a V6 edge board (13 mm tall). Origin = board end (x = 0) on the wall edge (y = 0); pads extend -x. 5 SMD signal pads on the inward face (F.Cu), 2.0 x 1.3 mm at 2.5 mm pitch (1.2 mm gaps, like the 2.54 mm controller joint): from the wall edge up 1 D (z 1.5), 2 CANH (4.0), 3 CANL (6.5), 5 DRIVE (9.0), 4 SENSE (11.5); this order lets the LED data and the bus reach their pads without crossing. 3 SMD power pads on the exterior face (B.Cu), 3.0 mm wide: 6 +36V (z 0.5-3.5), 8 GND (z 6.0-8.5), 7 +5V_LED (z 11.0-12.6). GND sits between the supplies with 2.5 mm gaps, so a bead can never join +36V to +5V_LED. All pads touch the board end. Mirror of CornerJoint_L.")
		(tags "corner joint solder bridge")
		(property "Reference" "J3"
			(at -3 -13.8 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "70ef5f36-b18b-4034-9c75-eb98b87bc8be")
