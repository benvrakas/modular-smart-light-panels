	(label "SPARE" (at 33.02 68.58 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0d847937-476e-40a8-869a-41a6697ff211"))
	(text "J1: all 10 contact pads on the exterior face (B.Cu), pressed by the seam bridge's springs.\nX1..X10 = GND +12V GND CANH CANL DRIVE SENSE_EDGE SPARE +12V GND. SENSE_EDGE meets the\nneighbour's DRIVE through the bridge (cross-connect). J2 (left end, footprint _L) mates with\nthe previous board's J3 (right end, _R). Corner pads: D CANH CANL SENSE DRIVE on F.Cu;\n+5V / GND / +12V on B.Cu (GND between the supplies). +5V stays inside the panel.\nOn the active board, J2 D_IN carries the loop-back from the last LED of the panel." (exclude_from_sim no) (at 15 74 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "815c87ca-9b4f-4275-b803-ddbfd4943463"))
	(text "2. LED CHAIN (all boards) - SKC6812RGBW 5V RGBW (32-bit GRBW), no backup data line" (exclude_from_sim no) (at 15 92 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "23e292a9-8a69-421c-b091-b7174fd31099"))
