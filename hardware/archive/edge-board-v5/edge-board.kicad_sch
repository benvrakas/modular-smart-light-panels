	(text "GPIO map\nPA0  LED_EN      5V LED-rail buck enable (high = on)\nPA1  SENSE_ADC   ADC_IN1 discovery\nPA2  UART_TX     USART2 debug pad\nPA3  UART_RX     USART2 debug pad\nPA4  DRIVE_GPIO  open-drain, Hi-Z idle\nPA5  CAN_RS      high = transceiver standby\nPA6  LED_RET     TIM3_CH1 ext. clock edge count (loop-back); SPI1_MISO alt.\nPA7  LED_DATA    SPI1_MOSI + DMA (SK6812 bits) -> U4\nPA11 CAN_RX     PA12 CAN_TX\nPB1  GPIO_SPARE  spare\nPD0/PD1 8MHz crystal (CAN needs a crystal clock)" (exclude_from_sim no) (at 15 256.54 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "6ba2c8d9-fc39-4777-9720-d52be673b9ed"))
